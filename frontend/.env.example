# 前端环境变量
# Vite 会自动注入 VITE_ 前缀的变量到客户端代码

# ===== 生产环境（Vercel Dashboard 中设置）=====
# Render 后端地址 — 文案提取 API 的目标服务器
# 部署后端到 Render 后，将获取到的 URL 填入下方
# 例如: https://video-parser-backend.onrender.com
VITE_API_BASE_URL=

# ===== 本地开发环境（.env 文件）=====
# Vite 代理目标 — 将 /api 请求转发到本地后端
# 此变量仅用于 vite.config.ts 的 server.proxy，不会注入客户端
VITE_PROXY_TARGET=http://localhost:3000
